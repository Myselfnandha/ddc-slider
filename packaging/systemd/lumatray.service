[Unit]
Description=LumaTray Next-Generation Monitor Control Suite
Documentation=https://github.com/nandha/ddc-slider
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m lumatray
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
