# Maintainer: Nandha
pkgname=lumatray
pkgver=3.0.0
pkgrel=1
pkgdesc='Next-Generation GTK3 Monitor Control Suite (DDC/CI, Color Management, Smart Automation)'
arch=('any')
url='https://github.com/nandha/ddc-slider'
license=('MIT')
depends=(
    'python'
    'python-gobject'
    'gtk3'
    'ddcutil'
    'brightnessctl'
    'xorg-xrandr'
)
optdepends=(
    'libayatana-appindicator: AppIndicator system tray support'
    'gammastep: Wayland and software color temperature control'
    'xprintidle: system idle dimming detection'
)
provides=('ddc-slider')
conflicts=('ddc-slider')
source=()
sha256sums=()

package() {
  local srcdir_repo="$startdir/.."

  # Install Python package
  python -m compileall "$srcdir_repo/src/lumatray"
  mkdir -p "$pkgdir/usr/lib/python3/dist-packages"
  cp -r "$srcdir_repo/src/lumatray" "$pkgdir/usr/lib/python3/dist-packages/"

  # Install binaries
  install -Dm755 "$srcdir_repo/bin/lumatray" "$pkgdir/usr/bin/lumatray"
  ln -sf /usr/bin/lumatray "$pkgdir/usr/bin/ddc-slider"

  # Install desktop files and systemd
  install -Dm644 "$srcdir_repo/data/lumatray.desktop" "$pkgdir/usr/share/applications/lumatray.desktop"
  install -Dm644 "$srcdir_repo/packaging/systemd/lumatray.service" "$pkgdir/usr/lib/systemd/user/lumatray.service"
  install -Dm644 "$srcdir_repo/packaging/udev/99-i2c-ddc.rules" "$pkgdir/usr/lib/udev/rules.d/99-i2c-ddc.rules"
  install -Dm644 "$srcdir_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
